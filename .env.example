OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6-luna
SITE_URL=https://your-site.example

# Leave authentication off for local development. Production should set it to true
# and should be reachable only through Cloudflare Access or another trusted proxy.
DOC2ANKI_AUTH_REQUIRED=false
DOC2ANKI_ALLOWED_EMAILS=
DOC2ANKI_ADMIN_EMAILS=

# Small-server safety defaults. These limits are per running server process.
DOC2ANKI_REQUESTS_PER_HOUR=20
DOC2ANKI_MAX_CONCURRENT_GENERATIONS=2
DOC2ANKI_MAX_QUEUED_GENERATIONS=20

# Required only for the production /admin friend manager.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_POLICY_ID=
CLOUDFLARE_API_TOKEN=
