OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6-luna
SITE_URL=https://your-site.example

# Leave authentication off for local development. Production should set it to true
# and should be reachable only through Cloudflare Access or another trusted proxy.
LAXU_AUTH_REQUIRED=false
LAXU_ALLOWED_EMAILS=

# Small-server safety defaults. These limits are per running server process.
LAXU_REQUESTS_PER_HOUR=20
LAXU_MAX_CONCURRENT_GENERATIONS=2
LAXU_MAX_QUEUED_GENERATIONS=20
