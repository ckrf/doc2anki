[Unit]
Description=Doc2Anki shared flashcard studio
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=doc2anki
Group=doc2anki
WorkingDirectory=/srv/doc2anki
Environment=NODE_ENV=production
EnvironmentFile=/etc/doc2anki.env
Environment=PATH=/opt/node22/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/opt/node22/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=3
TimeoutStopSec=20

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
