# Store the real file at /etc/laxu-focus.env with mode 600.
# Never commit a populated copy.
OPENAI_API_KEY=replace_with_a_dedicated_mylaxu_project_key
OPENAI_MODEL=gpt-5.6-luna
SITE_URL=https://doc2anki.com

# Cloudflare Access supplies the authenticated email header. Manage invitations
# in the Cloudflare Access policy so friends can be added without redeploying.
# This optional second allowlist can be populated if a frozen server-side list
# is ever preferred; when blank, any identity allowed by Access is accepted.
LAXU_AUTH_REQUIRED=true
LAXU_ALLOWED_EMAILS=

# One or two active generations is appropriate for this 4 GB server because
# uploaded files are converted for the model in memory.
LAXU_REQUESTS_PER_HOUR=20
LAXU_MAX_CONCURRENT_GENERATIONS=2
LAXU_MAX_QUEUED_GENERATIONS=20
