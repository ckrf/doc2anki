# Store the real file at /etc/laxu-focus.env with mode 600.
# Never commit a populated copy.
OPENAI_API_KEY=replace_with_a_dedicated_mylaxu_project_key
OPENAI_MODEL=gpt-5.6-luna
SITE_URL=https://laxu.example.com

# Cloudflare Access supplies the authenticated email header. Keep the same
# addresses in the Cloudflare Access policy and this defense-in-depth list.
LAXU_AUTH_REQUIRED=true
LAXU_ALLOWED_EMAILS=owner@example.com,friend@example.com

# One or two active generations is appropriate for a 1-2 GB server because
# uploaded files are converted for the model in memory.
LAXU_REQUESTS_PER_HOUR=20
LAXU_MAX_CONCURRENT_GENERATIONS=2
LAXU_MAX_QUEUED_GENERATIONS=20
