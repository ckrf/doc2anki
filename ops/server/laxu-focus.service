[Unit]
Description=MyLaxu shared flashcard studio
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=laxu-focus
Group=laxu-focus
WorkingDirectory=/srv/laxu-focus
Environment=NODE_ENV=production
EnvironmentFile=/etc/laxu-focus.env
Environment=PATH=/opt/node22/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/opt/node22/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=3
TimeoutStopSec=20

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
